# OPTIONAL — internal Markdown link check. DISABLED by default: the ".disabled"
# suffix makes GitHub ignore this file, so it never runs until you enable it.
#
# To enable it in your project:
#   git mv .github/workflows/link-check.yml.disabled .github/workflows/link-check.yml
#   git commit -m "Enable link-check CI" && git push
# It then runs on every push / pull request and fails on any of:
#   1. an internal Markdown link pointing at a file that doesn't exist,
#   2. a root-absolute link (`](/concept.md)`) — banned by CONVENTIONS § Linking
#      because it resolves against the site root, not the bundle root, so it
#      works nowhere: not on GitHub, not in an editor, not for an agent, or
#   3. a `[[slug]]` wikilink naming no concept in the bundle — so a project that
#      adopts the two-form variant has both forms checked, not just one.
# (Ignores links inside fenced blocks, inline code, and HTML comments, so
# documented link *syntax* examples don't trip it.)
name: link-check
on: [push, pull_request]
jobs:
  links:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check internal Markdown links
        run: |
          python3 - <<'PY'
          import re, os, glob, sys
          bad = 0
          concepts = {os.path.splitext(os.path.basename(p))[0]
                      for p in glob.glob('context/**/*.md', recursive=True)}
          for f in sorted(glob.glob('**/*.md', recursive=True)):
              text = open(f, encoding='utf-8').read()
              text = re.sub(r'<!--.*?-->', '', text, flags=re.DOTALL)  # drop HTML comments
              text = re.sub(r'```.*?```', '', text, flags=re.DOTALL)   # drop fenced code
              text = re.sub(r'`[^`]*`', '', text)                      # drop inline code
              base = os.path.dirname(f)
              for m in re.findall(r'\]\(([^)]+)\)', text):
                  t = m.split('#')[0].strip()
                  if not t or t.startswith(('http://', 'https://', 'mailto:')):
                      continue
                  # Root-absolute links resolve against the site root, not the
                  # bundle root. Never silently remap them — flag them.
                  if t.startswith('/'):
                      print(f'ROOT-ABSOLUTE  {f}  ->  {m}   (use a ./relative path)')
                      bad += 1
                      continue
                  if not os.path.exists(os.path.normpath(os.path.join(base, t))):
                      print(f'BROKEN  {f}  ->  {m}'); bad += 1
              # [[slug]] wikilinks resolve by concept name, not path.
              for w in re.findall(r'\[\[([^\]]+)\]\]', text):
                  slug = w.split('|')[0].split('#')[0].strip()
                  if slug not in concepts:
                      print(f'BROKEN WIKILINK  {f}  ->  [[{w}]]'); bad += 1
          print('all internal links resolve' if not bad else f'{bad} bad link(s)')
          sys.exit(1 if bad else 0)
          PY
